PROMPT;

                $userMessage = "TEKS MENTAH:\n" . $safeTextForAI
                    . "\n\nDAFTAR GAMBAR TERSEDIA:\n" . $imageManifestJson;

                $response = $client->chat()->create([
                    'model'           => 'gpt-4o-mini',
                    'response_format' => ['type' => 'json_object'],
                    'messages'        => [
                        ['role' => 'system', 'content' => $systemPrompt],
