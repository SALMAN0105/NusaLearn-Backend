                    ],
                ]);

                $aiData = json_decode($response->choices[0]->message->content, true);

                // =========================================================================
                // PHASE 3: JSON Post-Processing & Sanitization
                // =========================================================================
                $contentStructured = $aiData['content_structured'] ?? [];
