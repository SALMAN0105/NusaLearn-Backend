        html.dark .pagination-btn { background: #2d2460; color: #e2e8f0; }
        html.dark .pagination-btn.active { background: #7C3AED; }

        /* ========== Error Format Toast ========== */
        #format-error-toast {
            position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(120px);
