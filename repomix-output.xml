    <script>
        // DOMContentLoaded & Load Event Manager for O(1) Preloader dismissal
        window.addEventListener('load', function() {
            const preloader = document.getElementById('preloader');
            preloader.style.opacity = '0';
            setTimeout(() => {
                preloader.style.visibility = 'hidden';
            }, 600); // Sinkron dengan durasi transisi CSS
        });

        // Toggle Sidebar Imutabel
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('hidden');
            sidebar.classList.toggle('absolute'); 
            sidebar.classList.toggle('h-full');
            sidebar.classList.toggle('w-64');
        }

        // Animasi Modal Tersinkronisasi
        function toggleModal(modalID) {
            const modal = document.getElementById(modalID);
            const modalContent = document.getElementById('modal-content-lang');
            const body = document.querySelector('body');
            
            if (modal.classList.contains('opacity-0')) {
                // Eksekusi Buka (O(1) class toggle)
                modal.classList.remove('opacity-0', 'pointer-events-none');
                body.classList.add('modal-active');
                
                setTimeout(() => {
                    modalContent.classList.remove('scale-95', 'opacity-0');
                    modalContent.classList.add('scale-100', 'opacity-100');
                }, 10);
            } else {
                // Eksekusi Tutup
                modalContent.classList.remove('scale-100', 'opacity-100');
                modalContent.classList.add('scale-95', 'opacity-0');
                
                setTimeout(() => {
                    modal.classList.add('opacity-0', 'pointer-events-none');
                    body.classList.remove('modal-active');
                }, 300);
            }
        }
    </script>
</body>
</html>
