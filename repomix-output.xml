        @keyframes progress-fill { 0% { width: 0%; } 10% { width: 20%; } 30% { width: 45%; } 60% { width: 70%; } 85% { width: 88%; } 100% { width: 92%; } }
        @keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }

